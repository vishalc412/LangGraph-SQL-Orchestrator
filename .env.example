# Copy this file to .env and fill in your values

# ===================================
# Application Settings
# ===================================
APP_NAME="PostgreSQL AI Agent"
ENVIRONMENT="development"  # development, staging, production
DEBUG=false
LOG_LEVEL="INFO"  # DEBUG, INFO, WARNING, ERROR

# ===================================
# LLM Provider Settings
# ===================================
DEFAULT_LLM_PROVIDER="openai"  # openai or ollama

# OpenAI Configuration
OPENAI_API_KEY="sk-your-api-key-here"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_TEMPERATURE=0
OPENAI_MAX_TOKENS=2500
OPENAI_TIMEOUT=60

# Ollama Configuration (for local LLM)
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="llama3.1"
OLLAMA_TEMPERATURE=0
OLLAMA_TIMEOUT=120

# ===================================
# PostgreSQL Database Settings
# ===================================
# Option 1: Full connection URL (recommended)
POSTGRES_DATABASE_URL="postgresql://postgres:password@localhost:5432/movies_db"

# Option 2: Individual connection parameters (if DATABASE_URL not set)
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DATABASE="movies_db"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_password_here"
POSTGRES_SSL_MODE="prefer"  # disable, allow, prefer, require, verify-ca, verify-full

# Connection pool settings
POSTGRES_MIN_POOL_SIZE=2
POSTGRES_MAX_POOL_SIZE=10
POSTGRES_POOL_TIMEOUT=30

# Query settings
POSTGRES_QUERY_TIMEOUT=30  # seconds
POSTGRES_MAX_ROWS=1000  # maximum rows to return

# ===================================
# Memory Checkpointer Settings
# ===================================
CHECKPOINTER_TYPE="sqlite"  # memory, sqlite, postgres
CHECKPOINTER_SQLITE_PATH="./data/checkpoints.db"
CHECKPOINTER_POSTGRES_TABLE="conversation_checkpoints"

# ===================================
# Security Settings
# ===================================
SECURITY_ENABLE_SQL_VALIDATION=true
SECURITY_ENABLE_AUDIT_LOG=true
SECURITY_AUDIT_LOG_PATH="./logs/audit.log"

# ===================================
# Agent Settings
# ===================================
MAX_CONVERSATION_TURNS=10
ENABLE_STREAMING=true
ENABLE_QUERY_EXPLANATION=true
